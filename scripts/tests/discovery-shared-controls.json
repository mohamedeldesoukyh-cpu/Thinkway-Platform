[
  {
    "selector": ".discovery-suite .tw-search",
    "css": ".discovery-suite .tw-search{position:relative;display:inline-block}"
  },
  {
    "selector": ".discovery-suite .tw-search input",
    "css": ".discovery-suite .tw-search input{width:100%;padding-left:31px}"
  },
  {
    "selector": ".discovery-suite .tw-sw:hover",
    "css": ".discovery-suite .tw-sw:hover{background:#CBD5E3}"
  },
  {
    "selector": ".discovery-suite .tw-sw.on",
    "css": ".discovery-suite .tw-sw.on{background:var(--tw-blue)}"
  },
  {
    "selector": ".discovery-suite .tw-sw.on:hover",
    "css": ".discovery-suite .tw-sw.on:hover{background:var(--tw-bdk)}"
  },
  {
    "selector": ".discovery-suite .tw-sw.on::after",
    "css": ".discovery-suite .tw-sw.on::after{transform:translateX(14px)}"
  },
  {
    "selector": ".discovery-suite .tw-sw:focus-visible",
    "css": ".discovery-suite .tw-sw:focus-visible{outline:2px solid var(--tw-blue);outline-offset:2px}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__w",
    "css": ".discovery-suite .tw-dlg__w{width:min(520px,100%);background:#fff;border-radius:15px;overflow:hidden;\r\n box-shadow:0 24px 64px -18px rgba(11,15,26,.5);animation:tw-pop .2s var(--tw-ez)}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__h",
    "css": ".discovery-suite .tw-dlg__h{padding:15px 18px;background:linear-gradient(107deg,#EAF1FF,#F5F9FF);\r\n border-bottom:1px solid #DDE7FA;position:relative}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__h i",
    "css": ".discovery-suite .tw-dlg__h i{font-style:normal;font-size:8.5px;font-weight:700;letter-spacing:.75px;text-transform:uppercase;\r\n color:var(--tw-bi)}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__h b",
    "css": ".discovery-suite .tw-dlg__h b{display:block;margin-top:4px;font-size:15px;font-weight:600;color:var(--tw-navy)}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__h p",
    "css": ".discovery-suite .tw-dlg__h p{font-size:11.5px;color:var(--tw-mut);margin-top:4px;line-height:1.55;max-width:400px}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__b",
    "css": ".discovery-suite .tw-dlg__b{padding:16px 18px}"
  },
  {
    "selector": ".discovery-suite .tw-dlg__f",
    "css": ".discovery-suite .tw-dlg__f{display:flex;align-items:center;gap:8px;padding:12px 18px;border-top:1px solid var(--tw-line);\r\n background:var(--tw-soft)}"
  },
  {
    "selector": ".discovery-suite .tw-drop",
    "css": ".discovery-suite .tw-drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;\r\n padding:26px 20px;border:2px dashed #CFDDF7;border-radius:13px;background:var(--tw-lav);text-align:center}"
  },
  {
    "selector": ".discovery-suite .tw-drop .ic",
    "css": ".discovery-suite .tw-drop .ic{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#fff;\r\n color:var(--tw-bi);font-size:16px;font-weight:700}"
  },
  {
    "selector": ".discovery-suite .tw-drop b",
    "css": ".discovery-suite .tw-drop b{font-size:13.5px;font-weight:600}"
  },
  {
    "selector": ".discovery-suite .tw-drop p",
    "css": ".discovery-suite .tw-drop p{font-size:11px;color:var(--tw-mut);line-height:1.55;max-width:420px}"
  },
  {
    "selector": ".discovery-suite .tw-fsec",
    "css": ".discovery-suite .tw-fsec{border-bottom:1px solid var(--tw-hair)}"
  },
  {
    "selector": ".discovery-suite .tw-fsec__h",
    "css": ".discovery-suite .tw-fsec__h{display:flex;align-items:center;gap:9px;width:100%;padding:12px 16px;border:0;background:none;\r\n cursor:pointer;text-align:left}"
  },
  {
    "selector": ".discovery-suite .tw-fsec__h:hover",
    "css": ".discovery-suite .tw-fsec__h:hover{background:var(--tw-soft)}"
  },
  {
    "selector": ".discovery-suite .tw-fsec__h b",
    "css": ".discovery-suite .tw-fsec__h b{font-size:9px;font-weight:700;letter-spacing:.75px;text-transform:uppercase;color:var(--tw-bi)}"
  },
  {
    "selector": ".discovery-suite .tw-fsec__h .ar",
    "css": ".discovery-suite .tw-fsec__h .ar{margin-left:auto;font-size:9px;color:var(--tw-mut)}"
  },
  {
    "selector": ".discovery-suite .tw-fsec__b",
    "css": ".discovery-suite .tw-fsec__b{padding:0 16px 14px}"
  },
  {
    "selector": ".discovery-suite .tw-frow",
    "css": ".discovery-suite .tw-frow{margin-bottom:14px}"
  },
  {
    "selector": ".discovery-suite .tw-frow:last-child",
    "css": ".discovery-suite .tw-frow:last-child{margin-bottom:0}"
  },
  {
    "selector": ".discovery-suite .tw-fchips",
    "css": ".discovery-suite .tw-fchips{display:flex;flex-wrap:wrap;gap:6px}"
  },
  {
    "selector": ".discovery-suite .tw-fc:hover",
    "css": ".discovery-suite .tw-fc:hover{border-color:rgba(0,87,255,.34)}"
  },
  {
    "selector": ".discovery-suite .tw-fc.on",
    "css": ".discovery-suite .tw-fc.on{background:var(--tw-lav);border-color:#CDDCFF;color:var(--tw-bi);font-weight:600}"
  },
  {
    "selector": ".discovery-suite .tw-fc em",
    "css": ".discovery-suite .tw-fc em{font-style:normal;font-size:10px;color:var(--tw-mut)}"
  },
  {
    "selector": ".discovery-suite .tw-fc.on em",
    "css": ".discovery-suite .tw-fc.on em{color:var(--tw-bi)}"
  },
  {
    "selector": ".discovery-suite .tw-more:hover",
    "css": ".discovery-suite .tw-more:hover{text-decoration:underline}"
  }
]