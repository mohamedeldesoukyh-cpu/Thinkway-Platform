# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Environment label (local | staging | production) — used in structured logs and health probes
THINKWAY_ENV=local

# Observability
# JSON structured logs in production (set to 1 to force on, 0 to disable)
STRUCTURED_LOGS=
# Error reporting — no-op when unset; install @sentry/nextjs via wizard when ready
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Discovery latency metrics in production (auto-enabled when STRUCTURED_LOGS/production)
DISCOVERY_METRICS=
# Dev-only console search trace (set AI_SEARCH_TRACE=1)
AI_SEARCH_TRACE=

# Cron authentication (required in staging/production)
CRON_SECRET=

# Detailed /api/ready report (header x-ready-api-secret or Authorization: Bearer)
# Without this, anonymous /api/ready returns only { "status": "ok" }.
READY_API_SECRET=

# Optional HMAC secret for invite token hashing (defaults to SHA-256 if unset)
INVITE_TOKEN_SECRET=

# Comma-separated extra origins allowed for CSRF / Server Actions (in addition to NEXT_PUBLIC_APP_URL)
# Example: https://staging.thinkway.io,https://thinkway.io
CSRF_ALLOWED_ORIGINS=

# Client category classification — AI (server-side only; set on Vercel for auto-suggest)
# Same key used by the discovery worker. Without it, classification falls back to hints + keywords.
OPENAI_API_KEY=

# Client category classification — optional web search context (server-side only)
SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Discovery worker (optional local dev)
REDIS_URL=redis://127.0.0.1:6379

# Creator enrichment — import and enrichment are separate (see lib/creator-enrichment/enabled.ts)
# Master kill (disables ALL enrichment including manual refresh):
# DISABLE_CREATOR_ENRICHMENT=true
AUTO_IMPORT_ENRICHMENT=false
AUTO_CREATOR_ENRICHMENT=false
ALLOW_MANUAL_ENRICHMENT=true
ALLOW_BULK_ENRICHMENT=true
ALLOW_AVATAR_REFRESH=true
ALLOW_METRICS_REFRESH=true
ALLOW_PROFILE_REFRESH=true
ALLOW_AUDIENCE_REFRESH=true
ALLOW_CATEGORY_REFRESH=true

# Deprecated — ignored by application logic (use flags above):
# APIFY_ENRICHMENT_ENABLED=true
